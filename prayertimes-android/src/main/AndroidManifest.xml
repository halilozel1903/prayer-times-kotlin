<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reminders at the minute of each prayer. On Android 12+ the user grants it in Settings
         (PrayerReminderScheduler.exactAlarmSettingsIntent); without it reminders are inexact. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

</manifest>
